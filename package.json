{
  "name": "deepseek-harness-chatroom",
  "version": "1.2.0",
  "description": "Multi-user AI chatroom plugin for DeepSeek Harness Web",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build:host": "tsup src/index.ts --format esm --clean --sourcemap --out-dir dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:client": "tsdown && node scripts/verify-client-bundle.mjs",
    "build": "npm run build:host && npm run build:types && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run check && npm run test:browser",
    "prepack": "npm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "chatroom",
    "multi-user",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invclaw/DeepSeek-harness-chatroom.git"
  },
  "homepage": "https://github.com/invclaw/DeepSeek-harness-chatroom#readme",
  "bugs": {
    "url": "https://github.com/invclaw/DeepSeek-harness-chatroom/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "markdown-to-jsx": "9.10.2",
    "openid-client": "6.8.7",
    "sharp": "^0.35.3",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.7",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "^29.0.0",
    "playwright": "1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "unrun": "0.3.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19",
    "pnpm": "10.33.4"
  },
  "packageManager": "pnpm@10.33.4"
}
