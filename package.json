{
  "name": "deepseek-harness-chatroom",
  "version": "1.5.0-codex.rc1.1",
  "description": "Multi-user AI chatroom plugin for DeepSeek Harness Web",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build:host": "tsup src/index.ts --format esm --clean --sourcemap --out-dir dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:client": "tsdown && node scripts/verify-client-bundle.mjs",
    "build": "npm run build:host && npm run build:types && npm run build:client",
    "typecheck": "tsc --noEmit",
    "version:next": "node scripts/set-next-version.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run check && npm run test:browser",
    "prepack": "npm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "chatroom",
    "multi-user",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invclaw/DeepSeek-harness-chatroom.git"
  },
  "homepage": "https://github.com/invclaw/DeepSeek-harness-chatroom#readme",
  "bugs": {
    "url": "https://github.com/invclaw/DeepSeek-harness-chatroom/issues"
  },
